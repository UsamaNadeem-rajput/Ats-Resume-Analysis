# Copy this file and rename the copy to ".env":
# PowerShell: Copy-Item .env.example .env
# Put your real keys only in .env; never push .env to GitHub.

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string.
Mongourl=mongodb://127.0.0.1:27017/ats_resume_analyzer

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=local
CLIENT_ORIGIN=http://localhost:5173

# Maximum uploaded file size in MB. The code defaults to 5 MB if omitted.
MAX_UPLOAD_MB=5

# ── Authentication ───────────────────────────────────────────────────────────
# Google OAuth client ID. JWT_SECRET is still required for the other
# authenticated routes, even if Google login is not used.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth client secret. The current server code uses the Google client ID;
# this variable is reserved for a future OAuth flow.
CLIENT_SECRET=your-google-client-secret

# Use a long, random, private secret. Never share it or push it to GitHub.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── AI provider selection ────────────────────────────────────────────────────
# Allowed values: gemini or groq.
# If empty, the default order is Gemini -> Groq.
# If both keys exist and AI_PROVIDER=groq, the order becomes Groq -> Gemini.
AI_PROVIDER=

# A provider is available only when its API key is set.
# If both keys are set, the selected/default provider is tried first;
# the other provider is used as a fallback if it fails.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ── AI model mapping ─────────────────────────────────────────────────────────
# GEMINI_API_KEY  -> GEMINI_MODEL
# GROQ_API_KEY    -> GROQ_MODEL
#
# Set the model variable for the provider whose API key you are using.
# The code automatically removes a leading "models/" prefix if present.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

# If a model variable is empty, the code uses these defaults:
# Gemini: gemini-3.8-flash
# Groq:   openai/gpt-oss-120b

# Timeout for one API request, in milliseconds.
AI_TIMEOUT_MS=30000

# Maximum duration for the complete AI process, including retries and fallback.
AI_TOTAL_BUDGET_MS=45000
